<Page
    x:Class="TTwen.App.Views.Pages.ResourcesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource TtwenBackgroundBrush}">

  <Grid Padding="26">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="KAYNAK YÖNETİMİ" FontSize="28" FontWeight="Bold"
                   Foreground="{StaticResource TtwenAccentBrush}"/>
        <TextBlock Text="Seçili köyün canlı kaynak, kapasite ve saatlik üretim durumu"
                   Margin="0,5,0,0" Foreground="#71829D" FontSize="13"/>
        <TextBlock x:Name="SelectedVillageText"
                   Text="Köy seçilmedi"
                   Margin="0,8,0,0"
                   Foreground="#B9C7DB"
                   FontSize="12"/>
      </StackPanel>
      <Button x:Name="RefreshButton"
              Grid.Column="1"
              Content="KAYNAKLARI OKU"
              Click="RefreshButton_Click"
              Padding="18,10"/>
    </Grid>

    <Border Grid.Row="1"
            Background="{StaticResource TtwenPanelBrush}"
            BorderBrush="#1E3046"
            BorderThickness="1"
            CornerRadius="6"
            Padding="16"
            Margin="0,0,0,14">
      <Grid ColumnSpacing="26">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="DURUM" Foreground="#6F839F" FontSize="11"/>
          <TextBlock x:Name="StatusText" Text="Hazır" Margin="0,5,0,0"
                     Foreground="{StaticResource TtwenSuccessBrush}"
                     FontSize="15" FontWeight="SemiBold"/>
        </StackPanel>
        <StackPanel Grid.Column="1">
          <TextBlock Text="DEPO" Foreground="#6F839F" FontSize="11"/>
          <TextBlock x:Name="WarehouseText" Text="—" Margin="0,5,0,0"
                     Foreground="#E9F1FF" FontSize="15" FontWeight="Bold"/>
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="AMBAR" Foreground="#6F839F" FontSize="11"/>
          <TextBlock x:Name="GranaryText" Text="—" Margin="0,5,0,0"
                     Foreground="#E9F1FF" FontSize="15" FontWeight="Bold"/>
        </StackPanel>
        <StackPanel Grid.Column="3">
          <TextBlock Text="SON OKUMA" Foreground="#6F839F" FontSize="11"/>
          <TextBlock x:Name="LastReadText" Text="—" Margin="0,5,0,0"
                     Foreground="#B9C7DB" FontSize="12"/>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2"
            Background="{StaticResource TtwenPanelBrush}"
            BorderBrush="#1E3046"
            BorderThickness="1"
            CornerRadius="6"
            Padding="10">
      <ListView x:Name="ResourceList"
                SelectionMode="None">
        <ListView.ItemTemplate>
          <DataTemplate>
            <Border Background="#0A1019"
                    BorderBrush="#18283B"
                    BorderThickness="0,1,0,0"
                    Padding="14,14">
              <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="90"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="140"/>
                  <ColumnDefinition Width="140"/>
                  <ColumnDefinition Width="190"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}"
                           Foreground="#EDF5FF"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StockText}"
                               Foreground="#C6D5E8"
                               FontSize="13"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding FillText}"
                               Foreground="{Binding FillBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"/>
                  </Grid>
                  <ProgressBar Value="{Binding FillPercent}"
                               Maximum="100"
                               Height="6"
                               Margin="0,8,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="2"
                           Text="{Binding ProductionText}"
                           Foreground="#B6C5D9"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3"
                           Text="{Binding CapacityText}"
                           Foreground="#B6C5D9"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="4"
                           Text="{Binding StatusText}"
                           Foreground="{Binding StatusBrush}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>
              </Grid>
            </Border>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </Border>

    <TextBlock Grid.Row="3"
               x:Name="DetailsText"
               Margin="2,12,0,0"
               Foreground="#687B95"
               FontSize="11"
               TextWrapping="Wrap"/>
  </Grid>
</Page>