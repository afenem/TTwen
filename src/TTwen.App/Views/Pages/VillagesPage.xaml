<Page
    x:Class="TTwen.App.Views.Pages.VillagesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TTwen.App.Views.Pages"
    Background="{StaticResource TtwenBackgroundBrush}">

  <Grid Padding="26">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <StackPanel>
        <TextBlock Text="KÖYLER" FontSize="28" FontWeight="Bold"
                   Foreground="{StaticResource TtwenAccentBrush}"/>
        <TextBlock Text="TTWars canlı köy durumları"
                   Margin="0,5,0,0" Foreground="#71829D" FontSize="13"/>
      </StackPanel>

      <Button x:Name="RefreshButton"
              Grid.Column="1"
              Content="VERİLERİ YENİLE"
              Click="RefreshButton_Click"
              Padding="18,10"/>
    </Grid>

    <Border Grid.Row="1"
            Background="{StaticResource TtwenPanelBrush}"
            BorderBrush="#1E3046"
            BorderThickness="1"
            CornerRadius="6"
            Padding="16"
            Margin="0,0,0,14">
      <Grid ColumnSpacing="28">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel>
          <TextBlock Text="OKUMA DURUMU"
                     Foreground="#6F839F"
                     FontSize="11"
                     FontWeight="SemiBold"/>
          <TextBlock x:Name="StatusText"
                     Text="Hazır"
                     Margin="0,5,0,0"
                     Foreground="{StaticResource TtwenSuccessBrush}"
                     FontSize="15"
                     FontWeight="SemiBold"/>
        </StackPanel>

        <StackPanel Grid.Column="1">
          <TextBlock Text="KÖY SAYISI" Foreground="#6F839F" FontSize="11"/>
          <TextBlock x:Name="VillageCountText"
                     Text="0"
                     Margin="0,5,0,0"
                     Foreground="#E9F1FF"
                     FontSize="18"
                     FontWeight="Bold"/>
        </StackPanel>

        <StackPanel Grid.Column="2">
          <TextBlock Text="SON OKUMA" Foreground="#6F839F" FontSize="11"/>
          <TextBlock x:Name="LastReadText"
                     Text="—"
                     Margin="0,5,0,0"
                     Foreground="#B9C7DB"
                     FontSize="12"/>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2"
            x:Name="DetailsPanel"
            Background="#0B111B"
            BorderBrush="#18283B"
            BorderThickness="1"
            CornerRadius="6"
            Padding="12"
            Margin="0,0,0,14"
            Visibility="Collapsed">
      <TextBlock x:Name="DetailsText"
                 Foreground="{StaticResource TtwenWarningBrush}"
                 TextWrapping="Wrap"/>
    </Border>

    <Border Grid.Row="3"
            Background="{StaticResource TtwenPanelBrush}"
            BorderBrush="#1E3046"
            BorderThickness="1"
            CornerRadius="6"
            Padding="10">
      <ListView x:Name="VillageList"
                ItemsSource="{x:Bind Villages}"
                SelectionMode="None">
        <ListView.Header>
          <Grid Margin="8,8,8,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*"/>
              <ColumnDefinition Width="110"/>
              <ColumnDefinition Width="110"/>
              <ColumnDefinition Width="2*"/>
              <ColumnDefinition Width="2*"/>
              <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="KÖY" Foreground="#6F839F" FontSize="11"/>
            <TextBlock Grid.Column="1" Text="KOORD." Foreground="#6F839F" FontSize="11"/>
            <TextBlock Grid.Column="2" Text="NÜFUS" Foreground="#6F839F" FontSize="11"/>
            <TextBlock Grid.Column="3" Text="KAYNAKLAR" Foreground="#6F839F" FontSize="11"/>
            <TextBlock Grid.Column="4" Text="ÜRETİM / SAAT" Foreground="#6F839F" FontSize="11"/>
            <TextBlock Grid.Column="5" Text="DURUM" Foreground="#6F839F" FontSize="11"/>
          </Grid>
        </ListView.Header>

        <ListView.ItemTemplate>
          <DataTemplate x:DataType="local:VillagesPage.VillageRow">
            <Border Background="#0A1019"
                    BorderBrush="#18283B"
                    BorderThickness="0,1,0,0"
                    Padding="8,13">
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="2*"/>
                  <ColumnDefinition Width="110"/>
                  <ColumnDefinition Width="110"/>
                  <ColumnDefinition Width="2*"/>
                  <ColumnDefinition Width="2*"/>
                  <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                  <TextBlock Text="{x:Bind Name}"
                             Foreground="#EDF5FF"
                             FontSize="14"
                             FontWeight="SemiBold"/>
                  <TextBlock Text="{x:Bind Id}"
                             Margin="0,3,0,0"
                             Foreground="#5F718B"
                             FontSize="10"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{x:Bind CoordinatesText}"
                           Foreground="#B6C5D9"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="2"
                           Text="{x:Bind PopulationText}"
                           Foreground="#B6C5D9"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                  <TextBlock Text="{x:Bind ResourcesText}"
                             Foreground="#C6D5E8"
                             FontSize="12"/>
                  <TextBlock Text="{x:Bind StorageText}"
                             Margin="0,3,0,0"
                             Foreground="#60738E"
                             FontSize="10"/>
                </StackPanel>

                <TextBlock Grid.Column="4"
                           Text="{x:Bind ProductionText}"
                           Foreground="#C6D5E8"
                           FontSize="12"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="5"
                           Text="{x:Bind StatusText}"
                           Foreground="{StaticResource TtwenSuccessBrush}"
                           FontSize="11"
                           VerticalAlignment="Center"/>
              </Grid>
            </Border>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </Border>
  </Grid>
</Page>