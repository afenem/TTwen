<Page x:Class="TTwen.App.Views.Pages.TTWarsServerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer>
    <StackPanel Padding="26" Spacing="14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel>
          <TextBlock Text="TTWARS SUNUCU"
                     FontSize="30"
                     FontWeight="Bold"
                     Foreground="{StaticResource TtwenAccentBrush}"/>
          <TextBlock Text="Playwright tabanlı kalıcı sunucu bağlantısı ve tarayıcı oturum yönetimi."
                     Margin="0,4,0,0"
                     Foreground="#91A0B6"
                     TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Column="1"
                Background="#0B2130"
                BorderBrush="#28D7FF"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,7"
                VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="ConnectionDot"
                     Width="9"
                     Height="9"
                     Fill="{StaticResource TtwenWarningBrush}"
                     Margin="0,0,8,0"/>
            <TextBlock x:Name="ConnectionStateText"
                       Text="BAĞLANTI BEKLİYOR"
                       Foreground="{StaticResource TtwenWarningBrush}"
                       FontWeight="Bold"
                       FontSize="11"/>
          </StackPanel>
        </Border>
      </Grid>

      <Border Background="{StaticResource TtwenPanelBrush}"
              BorderBrush="#1F3048"
              BorderThickness="1"
              CornerRadius="14"
              Padding="20">
        <StackPanel Spacing="12">
          <TextBlock Text="SUNUCU BAĞLANTISI"
                     FontSize="18"
                     FontWeight="SemiBold"/>
          <TextBlock Text="Root adresi veya belirli bir TTWars sayfası girebilirsiniz; adres HTTP/HTTPS olarak doğrulanır."
                     Foreground="#71839E"
                     FontSize="11"
                     TextWrapping="Wrap"/>

          <TextBox x:Name="ServerUrlTextBox"
                   Header="TTWars sunucu adresi"
                   PlaceholderText="Örn. https://nor7.ttwars.com/dorf1.php"/>

          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button x:Name="ConnectButton"
                    Content="BAĞLAN"
                    Click="ConnectButton_Click"
                    Padding="18,10"/>
            <Button x:Name="DisconnectButton"
                    Content="BAĞLANTIYI KES"
                    Click="DisconnectButton_Click"
                    Padding="18,10"
                    IsEnabled="False"/>
          </StackPanel>

          <Border Background="#08111C"
                  BorderBrush="#21334B"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="12">
            <StackPanel Spacing="5">
              <TextBlock Text="DURUM"
                         FontSize="10"
                         Foreground="#71839E"/>
              <TextBlock x:Name="ConnectionMessageText"
                         Text="Bağlantı başlatılmadı."
                         FontSize="13"
                         TextWrapping="Wrap"/>
              <TextBlock x:Name="ConnectionDetailsText"
                         Foreground="#71839E"
                         FontSize="10"
                         TextWrapping="Wrap"
                         Visibility="Collapsed"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <Grid ColumnSpacing="14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition/>
          <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource TtwenPanelBrush}"
                BorderBrush="#1F3048"
                BorderThickness="1"
                CornerRadius="14"
                Padding="20">
          <StackPanel Spacing="8">
            <TextBlock Text="OTURUM BİLGİSİ"
                       FontSize="18"
                       FontWeight="SemiBold"/>
            <TextBlock Text="Aktif sunucu"
                       Foreground="#71839E"
                       FontSize="10"/>
            <TextBlock x:Name="CurrentServerText"
                       Text="—"
                       TextWrapping="Wrap"/>
            <TextBlock Text="Sayfa başlığı"
                       Foreground="#71839E"
                       FontSize="10"
                       Margin="0,6,0,0"/>
            <TextBlock x:Name="CurrentTitleText"
                       Text="—"
                       TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <Border Grid.Column="1"
                Background="{StaticResource TtwenPanelBrush}"
                BorderBrush="#1F3048"
                BorderThickness="1"
                CornerRadius="14"
                Padding="20">
          <StackPanel Spacing="9">
            <TextBlock Text="PLAYWRIGHT RUNTIME"
                       FontSize="18"
                       FontWeight="SemiBold"/>
            <TextBlock Text="TTwen kendi Chromium oturumunu kullanır. Tarayıcı henüz hazır değilse burada kurabilirsiniz."
                       Foreground="#71839E"
                       FontSize="10"
                       TextWrapping="Wrap"/>
            <Button x:Name="InstallChromiumButton"
                    Content="CHROMIUM'U HAZIRLA"
                    Click="InstallChromiumButton_Click"
                    Padding="15,9"/>
            <TextBlock x:Name="BrowserSetupStatusText"
                       Text="Hazırlık yapılmadı."
                       Foreground="#71839E"
                       FontSize="10"
                       TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </Grid>

      <Border Background="#09131F"
              BorderBrush="#18283D"
              BorderThickness="1"
              CornerRadius="12"
              Padding="16">
        <StackPanel Spacing="6">
          <TextBlock Text="ÇALIŞMA PRENSİBİ"
                     FontSize="14"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource TtwenAccentBrush}"/>
          <TextBlock Text="• Bağlantı hizmeti Playwright oturumunu yönetir."
                     FontSize="11"
                     Foreground="#D3DEEB"/>
          <TextBlock Text="• TTWars HTML/selector kodu Infrastructure katmanında kalır."
                     FontSize="11"
                     Foreground="#D3DEEB"/>
          <TextBlock Text="• Bu ekran henüz köy veya kaynak verisi okumaz; bağlantı sınırını doğrular."
                     FontSize="11"
                     Foreground="#D3DEEB"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>
