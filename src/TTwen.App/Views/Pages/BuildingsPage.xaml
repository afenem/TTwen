<Page
    x:Class="TTwen.App.Views.Pages.BuildingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource TtwenBackgroundBrush}">

  <Grid Padding="26">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="BİNALAR" FontSize="28" FontWeight="Bold"
                   Foreground="{StaticResource TtwenAccentBrush}"/>
        <TextBlock Text="Seçili TTWars köyünün dorf2 bina durumu"
                   Margin="0,5,0,0" Foreground="#71829D" FontSize="13"/>
        <TextBlock x:Name="SelectedVillageText"
                   Text="Köy seçilmedi"
                   Margin="0,8,0,0"
                   Foreground="#B9C7DB"
                   FontSize="12"/>
      </StackPanel>
      <Button x:Name="RefreshButton"
              Grid.Column="1"
              Content="BİNALARI OKU"
              Click="RefreshButton_Click"
              Padding="18,10"/>
    </Grid>

    <Border Grid.Row="1"
            Background="{StaticResource TtwenPanelBrush}"
            BorderBrush="#1E3046"
            BorderThickness="1"
            CornerRadius="6"
            Padding="16"
            Margin="0,0,0,14">
      <Grid ColumnSpacing="26">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="DURUM" Foreground="#6F839F" FontSize="11"/>
          <TextBlock x:Name="StatusText"
                     Text="Hazır"
                     Margin="0,5,0,0"
                     Foreground="{StaticResource TtwenSuccessBrush}"
                     FontSize="15"
                     FontWeight="SemiBold"/>
        </StackPanel>
        <StackPanel Grid.Column="1">
          <TextBlock Text="SLOT" Foreground="#6F839F" FontSize="11"/>
          <TextBlock x:Name="SlotCountText" Text="0" Margin="0,5,0,0"
                     Foreground="#E9F1FF" FontSize="18" FontWeight="Bold"/>
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="DOLU" Foreground="#6F839F" FontSize="11"/>
          <TextBlock x:Name="OccupiedCountText" Text="0" Margin="0,5,0,0"
                     Foreground="{StaticResource TtwenSuccessBrush}"
                     FontSize="18" FontWeight="Bold"/>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2"
            Background="{StaticResource TtwenPanelBrush}"
            BorderBrush="#1E3046"
            BorderThickness="1"
            CornerRadius="6"
            Padding="10">
      <ListView x:Name="BuildingList" SelectionMode="None">
        <ListView.Header>
          <Grid Margin="8,8,8,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="90"/>
              <ColumnDefinition Width="3*"/>
              <ColumnDefinition Width="100"/>
              <ColumnDefinition Width="100"/>
              <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="SLOT" Foreground="#6F839F" FontSize="11"/>
            <TextBlock Grid.Column="1" Text="BİNA" Foreground="#6F839F" FontSize="11"/>
            <TextBlock Grid.Column="2" Text="SEVİYE" Foreground="#6F839F" FontSize="11"/>
            <TextBlock Grid.Column="3" Text="GID" Foreground="#6F839F" FontSize="11"/>
            <TextBlock Grid.Column="4" Text="DURUM" Foreground="#6F839F" FontSize="11"/>
          </Grid>
        </ListView.Header>
        <ListView.ItemTemplate>
          <DataTemplate>
            <Border Background="#0A1019"
                    BorderBrush="#18283B"
                    BorderThickness="0,1,0,0"
                    Padding="8,12">
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="90"/>
                  <ColumnDefinition Width="3*"/>
                  <ColumnDefinition Width="100"/>
                  <ColumnDefinition Width="100"/>
                  <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding SlotId}" Foreground="#B6C5D9" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#EDF5FF"
                           FontSize="13" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding Level}" Foreground="#B6C5D9"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="{Binding Gid}" Foreground="#B6C5D9"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="{Binding Status}"
                           Foreground="{StaticResource TtwenSuccessBrush}"
                           FontSize="11" VerticalAlignment="Center"/>
              </Grid>
            </Border>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </Border>
  </Grid>
</Page>