<Page x:Class="TTwen.App.Views.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer>
    <StackPanel Padding="26">
      <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="DASHBOARD" FontSize="30" FontWeight="Bold"
                     Foreground="{StaticResource TtwenAccentBrush}"/>
          <TextBlock Text="TTWars hesabının merkezi kontrol paneli."
                     Foreground="#91A0B6" Margin="0,4,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse Width="9" Height="9" Fill="{StaticResource TtwenSuccessBrush}" Margin="0,0,7,0"/>
          <TextBlock Text="SİSTEM HAZIR" Foreground="{StaticResource TtwenSuccessBrush}"
                     FontWeight="SemiBold"/>
        </StackPanel>
      </Grid>

      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource TtwenPanelBrush}"
                BorderBrush="#1F3048" BorderThickness="1" CornerRadius="12" Padding="16">
          <StackPanel>
            <TextBlock Text="KÖYLER" Foreground="#71839E" FontSize="11"/>
            <TextBlock Text="0" FontSize="30" FontWeight="Bold" Foreground="{StaticResource TtwenAccentBrush}"/>
            <TextBlock Text="otomasyon profili aktif" Foreground="#71839E" FontSize="11"/>
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Background="{StaticResource TtwenPanelBrush}"
                BorderBrush="#1F3048" BorderThickness="1" CornerRadius="12" Padding="16">
          <StackPanel>
            <TextBlock Text="ASKER" Foreground="#71839E" FontSize="11"/>
            <TextBlock Text="0" FontSize="30" FontWeight="Bold" Foreground="{StaticResource TtwenSuccessBrush}"/>
            <TextBlock Text="toplam birlik" Foreground="#71839E" FontSize="11"/>
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Background="{StaticResource TtwenPanelBrush}"
                BorderBrush="#1F3048" BorderThickness="1" CornerRadius="12" Padding="16">
          <StackPanel>
            <TextBlock Text="VAHA" Foreground="#71839E" FontSize="11"/>
            <TextBlock Text="0" FontSize="30" FontWeight="Bold" Foreground="#B68CFF"/>
            <TextBlock Text="analiz kuyruğunda" Foreground="#71839E" FontSize="11"/>
          </StackPanel>
        </Border>

        <Border Grid.Column="3" Background="{StaticResource TtwenPanelBrush}"
                BorderBrush="#1F3048" BorderThickness="1" CornerRadius="12" Padding="16">
          <StackPanel>
            <TextBlock Text="NET KÂR / SAAT" Foreground="#71839E" FontSize="11"/>
            <TextBlock Text="+0" FontSize="30" FontWeight="Bold" Foreground="{StaticResource TtwenSuccessBrush}"/>
            <TextBlock Text="son hesaplanan" Foreground="#71839E" FontSize="11"/>
          </StackPanel>
        </Border>
      </Grid>

      <Grid Margin="0,18,0,0" ColumnSpacing="14">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.8*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>

        <Border Background="{StaticResource TtwenPanelBrush}"
                BorderBrush="#1F3048" BorderThickness="1" CornerRadius="14" Padding="18">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="İŞLEM MERKEZİ" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="Botun yaptığı işlemlerin merkezi görünümü."
                           Foreground="#72849D" FontSize="11"/>
              </StackPanel>
              <Border Grid.Column="1" Background="#0B2130" BorderBrush="{StaticResource TtwenAccentBrush}"
                      BorderThickness="1" CornerRadius="7" Padding="9,5">
                <TextBlock Text="CANLI" Foreground="{StaticResource TtwenAccentBrush}"
                           FontSize="10" FontWeight="Bold"/>
              </Border>
            </Grid>

            <Grid Margin="0,16,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
              <Ellipse Width="8" Height="8" Fill="{StaticResource TtwenSuccessBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1">
                <TextBlock Text="Sistem başlatıldı" FontSize="12"/>
                <TextBlock Text="Uygulama motoru hazır." FontSize="10" Foreground="#687C95"/>
              </StackPanel>
              <TextBlock Grid.Column="2" Text="SYSTEM" FontSize="10" Foreground="#6D819E"/>
            </Grid>

            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
              <Ellipse Width="8" Height="8" Fill="#B68CFF" HorizontalAlignment="Left" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1">
                <TextBlock Text="Vaha analiz motoru" FontSize="12"/>
                <TextBlock Text="Simülasyon kuyruğu hazır." FontSize="10" Foreground="#687C95"/>
              </StackPanel>
              <TextBlock Grid.Column="2" Text="OASIS" FontSize="10" Foreground="#6D819E"/>
            </Grid>

            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
              <Ellipse Width="8" Height="8" Fill="{StaticResource TtwenWarningBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1">
                <TextBlock Text="Bina planlayıcı" FontSize="12"/>
                <TextBlock Text="Şablon motoru bekliyor." FontSize="10" Foreground="#687C95"/>
              </StackPanel>
              <TextBlock Grid.Column="2" Text="BUILD" FontSize="10" Foreground="#6D819E"/>
            </Grid>
          </StackPanel>
        </Border>

        <StackPanel Grid.Column="1">
          <Border Background="{StaticResource TtwenPanelBrush}"
                  BorderBrush="#1F3048" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="KÖY DURUMU" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock Text="Kaynak kapasitesi" Margin="0,12,0,4" FontSize="11" Foreground="#71839E"/>
              <ProgressBar Value="0" Maximum="100" Height="7"/>
              <TextBlock Text="0 / 0 kapasite" FontSize="10" Foreground="#71839E" Margin="0,4,0,0"/>
              <TextBlock Text="Bina kuyruğu" Margin="0,12,0,3" FontSize="11" Foreground="#71839E"/>
              <TextBlock Text="Hazır" Foreground="{StaticResource TtwenSuccessBrush}"/>
            </StackPanel>
          </Border>

          <Border Background="{StaticResource TtwenPanelBrush}"
                  BorderBrush="#1F3048" BorderThickness="1" CornerRadius="14" Padding="18">
            <StackPanel>
              <TextBlock Text="ÖNCELİKLİ MODÜLLER" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock Text="Vaha Yağması" Margin="0,10,0,0" Foreground="#B68CFF"/>
              <TextBlock Text="Köy Kurma" Margin="0,7,0,0" Foreground="{StaticResource TtwenAccentBrush}"/>
              <TextBlock Text="Bina Planlayıcı" Margin="0,7,0,0" Foreground="#DDE7F4"/>
              <TextBlock Text="Farm" Margin="0,7,0,0" Foreground="#DDE7F4"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</Page>