<Window x:Class="TTwen.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="TTwen • TTWars Control Center">
  <Grid Background="{StaticResource TtwenBackgroundBrush}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="235"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0"
            Background="#090F19"
            BorderBrush="#17283C"
            BorderThickness="0,0,1,0">
      <Grid Padding="16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
          <TextBlock Text="TTWEN"
                     FontSize="27"
                     FontWeight="Bold"
                     Foreground="{StaticResource TtwenAccentBrush}"/>
          <TextBlock Text="TTWARS CONTROL CENTER"
                     Margin="0,3,0,0"
                     Foreground="#7285A2"
                     FontSize="10"/>
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,18,0,14"
                Padding="10"
                Background="#0D1622"
                BorderBrush="#1B3047"
                BorderThickness="1"
                CornerRadius="5">
          <StackPanel>
            <TextBlock Text="SİSTEM"
                       Foreground="#6E829E"
                       FontSize="10"/>
            <TextBlock Text="Hazır"
                       Margin="0,3,0,0"
                       Foreground="{StaticResource TtwenSuccessBrush}"
                       FontSize="12"
                       FontWeight="SemiBold"/>
          </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="4">
            <Button Content="Dashboard"
                    Tag="Dashboard"
                    Click="NavigationButton_Click"
                    HorizontalContentAlignment="Left"/>
            <Button Content="TTWars Sunucu"
                    Tag="Server"
                    Click="NavigationButton_Click"
                    HorizontalContentAlignment="Left"/>
            <Button Content="Köyler"
                    Tag="Villages"
                    Click="NavigationButton_Click"
                    HorizontalContentAlignment="Left"/>
            <Button Content="Köy Kurma"
                    Tag="VillageSetup"
                    Click="NavigationButton_Click"
                    HorizontalContentAlignment="Left"/>
            <Button Content="Binalar"
                    Tag="Buildings"
                    Click="NavigationButton_Click"
                    HorizontalContentAlignment="Left"/>
            <Button Content="Kaynak Yönetimi"
                    Tag="Resources"
                    Click="NavigationButton_Click"
                    HorizontalContentAlignment="Left"/>
            <Button Content="Askerler"
                    Tag="Troops"
                    Click="NavigationButton_Click"
                    HorizontalContentAlignment="Left"/>
            <Button Content="Farm"
                    Tag="Farm"
                    Click="NavigationButton_Click"
                    HorizontalContentAlignment="Left"/>
            <Button Content="Vaha Yağması"
                    Tag="Oasis"
                    Click="NavigationButton_Click"
                    HorizontalContentAlignment="Left"/>
            <Button Content="Natar"
                    Tag="Natar"
                    Click="NavigationButton_Click"
                    HorizontalContentAlignment="Left"/>
            <Button Content="Kahraman"
                    Tag="Hero"
                    Click="NavigationButton_Click"
                    HorizontalContentAlignment="Left"/>
            <Button Content="Savaş Simülatörü"
                    Tag="Simulator"
                    Click="NavigationButton_Click"
                    HorizontalContentAlignment="Left"/>
            <Button Content="Raporlar"
                    Tag="Reports"
                    Click="NavigationButton_Click"
                    HorizontalContentAlignment="Left"/>
            <Button Content="Pazar / Transfer"
                    Tag="Market"
                    Click="NavigationButton_Click"
                    HorizontalContentAlignment="Left"/>
            <Button Content="İşlem Merkezi"
                    Tag="Operations"
                    Click="NavigationButton_Click"
                    HorizontalContentAlignment="Left"/>
            <Button Content="Loglar"
                    Tag="Logs"
                    Click="NavigationButton_Click"
                    HorizontalContentAlignment="Left"/>
            <Button Content="Ayarlar"
                    Tag="Settings"
                    Click="NavigationButton_Click"
                    HorizontalContentAlignment="Left"/>
          </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="3"
                   Text="C# / .NET 10 • Windows x64"
                   Margin="2,14,2,0"
                   Foreground="#5E7088"
                   FontSize="10"/>
      </Grid>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="64"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="28"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0"
            Background="#0A111C"
            BorderBrush="#17283C"
            BorderThickness="0,0,0,1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Margin="22,0,0,0"
                    VerticalAlignment="Center">
          <TextBlock Text="KONTROL MERKEZİ"
                     Foreground="#E9F1FF"
                     FontSize="17"
                     FontWeight="SemiBold"/>
          <TextBlock Text="TTWars otomasyon ve durum yönetimi"
                     Margin="0,3,0,0"
                     Foreground="#6E819C"
                     FontSize="11"/>
        </StackPanel>

        <TextBlock Grid.Column="1"
                   Text="SİSTEM AKTİF"
                   Margin="0,0,22,0"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource TtwenSuccessBrush}"
                   FontSize="11"
                   FontWeight="SemiBold"/>
      </Grid>

      <Frame x:Name="ContentFrame"
             Grid.Row="1"
             Background="{StaticResource TtwenBackgroundBrush}"/>

      <Grid Grid.Row="2"
            Background="#0A111C">
        <TextBlock Text="TTwen • Sürekli çalışma modu"
                   Margin="14,0"
                   VerticalAlignment="Center"
                   Foreground="#5E7088"
                   FontSize="10"/>
      </Grid>
    </Grid>
  </Grid>
</Window>
